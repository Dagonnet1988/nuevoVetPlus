# ===========================================
# CONFIGURACIÓN VETPLUS - VARIABLES DE ENTORNO
# ===========================================

# Servidor
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4200

# Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vetplus
DB_USER=postgres
DB_PASSWORD=

# Autenticación JWT
JWT_SECRET=vetplus_super_secret_key_2024
JWT_EXPIRES_IN=24h

# Email SMTP (nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@vetplus.com

# WhatsApp (Baileys)
WHATSAPP_SESSION_PATH=./whatsapp_session
WHATSAPP_ENABLED=false

# Google Calendar API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=

# Configuración de la clínica
CLINIC_NAME=VetPlus Clínica
CLINIC_ADDRESS=
CLINIC_PHONE=
CLINIC_EMAIL=

# Configuración de notificaciones
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_WHATSAPP_ENABLED=false
VENCIMIENTO_DIAS_ALERTA=7

# Configuración de reportes
REPORTS_PATH=./reports
BACKUP_PATH=./backups

# Configuración de logs
LOG_LEVEL=info
LOG_FILE=./logs/vetplus.log
