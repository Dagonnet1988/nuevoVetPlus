# ===========================================
# CONFIGURACIÓN VETPLUS - VARIABLES DE ENTORNO
# ===========================================

# Servidor
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4200

# Base de Datos PostgreSQL (Neon.tech)
# Obtén estos valores desde https://console.neon.tech
DATABASE_URL='postgresql://<db_user>:<db_password>@<db_host>/<db_name>?sslmode=require&channel_binding=require'
DB_HOST=<db_host>
DB_NAME=<db_name>
DB_USER=<db_user>
DB_PASSWORD=<db_password>

# Superadmin de plataforma (se crea automáticamente en el primer arranque)
# OBLIGATORIO para la primera instalación
SUPERADMIN_EMAIL=admin@vetplus.com
SUPERADMIN_PASSWORD=<min_8_caracteres>
SUPERADMIN_NOMBRE=Super Admin

# Autenticación JWT
# OBLIGATORIO en producción (mínimo 32 caracteres)
JWT_SECRET=<generate_a_strong_secret_min_32_chars>
JWT_EXPIRES_IN=24h

# Email SMTP (nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@vetplus.com

# WhatsApp (Baileys)
WHATSAPP_SESSION_PATH=./whatsapp_session
WHATSAPP_ENABLED=false

# Google Calendar API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=

# Configuración de la clínica
CLINIC_NAME=VetPlus Clínica
CLINIC_ADDRESS=
CLINIC_PHONE=
CLINIC_EMAIL=

# Configuración de notificaciones
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_WHATSAPP_ENABLED=false
VENCIMIENTO_DIAS_ALERTA=7

# Configuración de reportes
REPORTS_PATH=./reports
BACKUP_PATH=./backups

# Configuración de logs
LOG_LEVEL=info
LOG_FILE=./logs/vetplus.log

# Sincronización Google Calendar
# false = solo Google -> VetPlus
# true  = bidireccional (VetPlus -> Google habilitado)
GOOGLE_SYNC_OUTBOUND_ENABLED=false
