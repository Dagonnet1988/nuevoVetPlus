# ===========================================
# PRODUCCIÓN WINDOWS - VARIABLES DE ENTORNO
# ===========================================

# Servidor
NODE_ENV=production
PORT=3000
FRONTEND_URL=http://localhost:4200

# Base de Datos PostgreSQL WINDOWS
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vetplus
DB_USER=postgres
DB_PASSWORD=TU_PASSWORD_SEGURO_AQUI

# Autenticación JWT
JWT_SECRET=vetplus_production_secret_key_super_seguro_2024
JWT_EXPIRES_IN=24h

# Email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASS=tu_app_password
SMTP_FROM=noreply@vetplus.com

# WhatsApp (Baileys)
WHATSAPP_SESSION_PATH=./whatsapp_session
WHATSAPP_ENABLED=true

# Google Calendar API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=

# Configuración de la clínica
CLINIC_NAME=VetPlus Clínica
CLINIC_ADDRESS=Tu dirección completa
CLINIC_PHONE=+57 300 123 4567
CLINIC_EMAIL=info@vetplus.com

# Configuración de notificaciones
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_WHATSAPP_ENABLED=true
VENCIMIENTO_DIAS_ALERTA=7

# Configuración de reportes y backup
REPORTS_PATH=C:/VetPlus/reports
BACKUP_PATH=C:/VetPlus/backups

# Configuración de logs
LOG_LEVEL=info
LOG_FILE=C:/VetPlus/logs/vetplus.log
