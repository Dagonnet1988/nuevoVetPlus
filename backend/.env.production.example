# ===============================================
# VetPlus Backend - Configuración de Entorno
# ===============================================

# ===== CONFIGURACIÓN GENERAL =====
NODE_ENV=production
PORT=3000
APP_NAME=VetPlus
APP_VERSION=1.0.0

# ===== BASE DE DATOS =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vetplus
DB_USER=vetplus_user
DB_PASSWORD=secure_password_here
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=20

# ===== AUTENTICACIÓN JWT =====
JWT_SECRET=your_super_secure_jwt_secret_key_here_minimum_256_bits
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your_refresh_token_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# ===== SEGURIDAD =====
BCRYPT_ROUNDS=12
SESSION_SECRET=your_session_secret_here
CORS_ORIGIN=https://vetplus.com,https://www.vetplus.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# ===== GOOGLE CALENDAR =====
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://api.vetplus.com/api/google-calendar/callback

# ===== EMAIL =====
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=noreply@vetplus.com
EMAIL_PASSWORD=your_email_app_password_here
EMAIL_FROM=VetPlus <noreply@vetplus.com>

# ===== ARCHIVOS Y UPLOADS =====
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# ===== LOGS =====
LOG_LEVEL=info
LOG_FILE_PATH=./logs/vetplus.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
LOG_DATE_PATTERN=YYYY-MM-DD

# ===== CACHE Y PERFORMANCE =====
CACHE_TTL=300
CACHE_MAX_KEYS=1000
REDIS_URL=redis://localhost:6379
ENABLE_COMPRESSION=true
COMPRESSION_LEVEL=6

# ===== MONITORING =====
ENABLE_METRICS=true
METRICS_ENDPOINT=/metrics
HEALTH_CHECK_ENDPOINT=/health
PROMETHEUS_PORT=9090

# ===== EXTERNAL APIS =====
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
SENDGRID_API_KEY=your_sendgrid_api_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# ===== BACKUP =====
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=vetplus-backups
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1

# ===== NOTIFICACIONES =====
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/slack/webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/discord/webhook
ENABLE_ALERTS=true
ALERT_EMAIL=admin@vetplus.com

# ===== DESARROLLO Y DEBUG =====
DEBUG=vetplus:*
VERBOSE_LOGGING=false
ENABLE_REQUEST_LOGGING=true
ENABLE_SQL_LOGGING=false

# ===== SSL/TLS =====
SSL_ENABLED=true
SSL_CERT_PATH=./ssl/cert.pem
SSL_KEY_PATH=./ssl/key.pem
SSL_CA_PATH=./ssl/ca.pem

# ===== FEATURES FLAGS =====
ENABLE_GOOGLE_CALENDAR=true
ENABLE_REPORTS=true
ENABLE_AUDIT=true
ENABLE_ADVANCED_ANALYTICS=true
ENABLE_MOBILE_APP_API=true

# ===== TIMEZONE =====
TIMEZONE=America/Bogota
DEFAULT_LOCALE=es-CO

# ===== LIMITES DEL SISTEMA =====
MAX_CLIENTS_PER_CLINIC=10000
MAX_PETS_PER_CLIENT=50
MAX_APPOINTMENTS_PER_DAY=200
MAX_INVOICE_ITEMS=100

# ===== CLINIC SPECIFIC =====
CLINIC_NAME=Mi Clínica Veterinaria
CLINIC_ADDRESS=Calle 123 #45-67, Bogotá, Colombia
CLINIC_PHONE=+57 300 123 4567
CLINIC_EMAIL=info@miclinica.com
CLINIC_WEBSITE=https://miclinica.com