{
  "name": "vetplus-backend",
  "version": "1.0.0",
  "description": "VetPlus - Backend API para gestion clinica veterinaria",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:simple": "node server-simple.js",
    "start:production": "NODE_ENV=production node server-production.js",
    "start:prod": "npm run start:production",
    "dev": "NODE_ENV=development nodemon server.js",
    "dev:simple": "NODE_ENV=development nodemon server-simple.js",
    "dev:production": "NODE_ENV=production nodemon server-production.js",
    "test": "NODE_ENV=test jest",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:coverage": "NODE_ENV=test jest --coverage",
    "test:isolation": "NODE_ENV=test node --test tests/c8-tenant-isolation.test.js",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "validate:config": "node -e \"import('./src/config/production.js').then(({validateConfig}) => validateConfig())\"",
    "health:check": "curl -f http://localhost:3000/health || exit 1",
    "docs:generate": "node -e \"console.log('📚 Documentación disponible en: http://localhost:3000/api/docs')\"",
    "cache:clear": "curl -X POST http://localhost:3000/admin/cache/clear -H 'Authorization: Bearer YOUR_ADMIN_TOKEN'",
    "metrics:view": "curl http://localhost:3000/metrics",
    "build": "echo '✅ No build required for Node.js backend'",
    "postinstall": "echo '📦 Dependencias instaladas correctamente'",
    "prestart": "npm run validate:config",
    "db:init": "node bin/dbinit.js init",
    "db:check": "node bin/dbinit.js check",
    "db:status": "node bin/dbinit.js status",
    "db:migrate": "node bin/db.js migrate",
    "db:seed": "node -e \"import('./src/config/database.js').then(({query}) => import('fs/promises').then(fs => fs.readFile('./src/database/seeds/01_initial_data.sql', 'utf8').then(data => query(data).then(() => console.log('✅ Seeds ejecutados')).catch(console.error))));\"",
    "db:test": "node bin/test-db.js",
    "db:reset": "node -e \"import('./src/config/database.js').then(({query}) => query('DROP SCHEMA public CASCADE; CREATE SCHEMA public;').then(() => console.log('⚠️ Base de datos reseteada')).catch(console.error));\"",
    "db:backup": "pg_dump $DB_NAME > backups/backup-$(date +%Y%m%d_%H%M%S).sql",
    "db:restore": "psql $DB_NAME < backups/backup.sql",
    "security:audit": "npm audit --audit-level=moderate",
    "security:fix": "npm audit fix",
    "performance:test": "echo '🚀 Ejecutar tests de performance con Artillery o similar'",
    "logs:setup": "mkdir -p logs && touch logs/vetplus.log",
    "logs:view": "tail -f logs/vetplus.log 2>/dev/null || echo 'Crear directorio logs primero: npm run logs:setup'",
    "logs:clear": "truncate -s 0 logs/vetplus.log 2>/dev/null || echo 'Archivo de log no existe'",
    "deploy:staging": "echo '🚀 Deploy to staging environment'",
    "deploy:production": "echo '🚀 Deploy to production environment'"
  },
  "keywords": [
    "veterinary",
    "clinic",
    "api",
    "nodejs"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@types/multer": "^2.0.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.3.1",
    "express-slow-down": "^2.1.0",
    "express-validator": "^7.3.1",
    "googleapis": "^154.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.10.0",
    "pdfkit": "^0.15.0",
    "pg": "^8.16.3",
    "pino": "^9.7.0",
    "qrcode": "^1.5.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "nodemon": "^3.1.10"
  }
}
