# Copiar este archivo en el VPS como:
# /var/www/vetplus/backend/.env.production
# NO subir valores reales a git.

# ==========================
# Minimo real para produccion
# ==========================

# Servidor
NODE_ENV=production
PORT=3000

# URLs publicas
FRONTEND_URL=https://ramelo.app
BACKEND_URL=https://api.ramelo.app
BACKEND_PUBLIC_URL=https://api.ramelo.app

# Base de datos
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=vetplus
DB_USER=vetplus_user
DB_PASSWORD=REEMPLAZAR_PASSWORD_DB
DB_SSL=false

# Autenticacion
# Requerida (minimo 32 caracteres)
JWT_SECRET=REEMPLAZAR_JWT_SECRET_LARGO
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=12h
REQUIRE_TENANT_ON_LOGIN=true

# Superadmin inicial
SUPERADMIN_EMAIL=admin@ramelo.app
SUPERADMIN_DOCUMENTO=REEMPLAZAR_DOCUMENTO
SUPERADMIN_PASSWORD=REEMPLAZAR_PASSWORD_SEGURA

# Google Calendar (flujo por tenant en BD)
ENABLE_GOOGLE_CALENDAR=true
GOOGLE_SYNC_OUTBOUND_ENABLED=false
GOOGLE_SYNC_LOOKBACK_DAYS=7
GOOGLE_SYNC_LOOKAHEAD_DAYS=30
GOOGLE_WEBHOOK_VERIFY_TOKEN=REEMPLAZAR_WEBHOOK_TOKEN
GOOGLE_WEBHOOK_URL=https://api.ramelo.app/api/google-calendar-webhook

# Archivos
UPLOAD_PATH=/var/vetplus/uploads
MAX_FILE_SIZE=5242880

# Logs
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true
